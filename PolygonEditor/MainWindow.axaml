<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PolygonEditor.Views"
        x:Class="PolygonEditor.MainWindow"
        Width="1000" Height="650"
        Title="Polygon Editor">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6" Spacing="12">
            <RadioButton GroupName="Algorithm" Content="Library Algorithm" IsChecked="True" />
            <RadioButton x:Name="BresenhamRadio" GroupName="Algorithm" Content="Bresenham Algorithm"
                         IsCheckedChanged="OnBresenhamChanged" />
            <Button Content="Help" Click="OnHelpClick" />
        </StackPanel>         
        <views:EditorCanvas x:Name="Editor" />
    </DockPanel>
</Window>